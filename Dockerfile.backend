# Multi-Stage Production Dockerfile for Axiom FastAPI Backend
FROM python:3.13-slim AS builder

WORKDIR /app

# Install system build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency definition
COPY pyproject.toml .

# Install dependencies into virtualenv
RUN uv venv /app/.venv && uv pip install --no-cache -r pyproject.toml

# Final production stage
FROM python:3.13-slim AS runner

WORKDIR /app

# Create non-root enterprise user
RUN useradd -m -u 1001 appuser

# Copy virtualenv and application source
COPY --from=builder /app/.venv /app/.venv
COPY src/backend /app/src/backend
COPY src/backend/alembic /app/alembic
COPY alembic.ini /app/alembic.ini

# Set environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PORT=8000

USER appuser

EXPOSE 8000

CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
