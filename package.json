{
  "name": "axiom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix src/frontend run dev",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "src/frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "src/backend/**/*.py": [
      "black --line-length=100",
      "isort",
      "flake8"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
